# Chiavi del Growth RIVO Team. SOLO I NOMI: i valori vivono nelle
# variabili dell'environment di claude.ai (o nel .env locale, MAI committato).
# Regola 8 del CLAUDE.md: segreti mai nel repo, in nessun file e nessun commit.
#
# Disciplina per ruolo: ogni skill dichiara nelle sue leggi QUALI chiavi le
# competono. Le altre non si toccano, anche se visibili nell'environment.

# RIVO VIDEO: generazione video/immagini su Kie.ai (Veo 3.1, GPT Image 2)
KIE_API_KEY=

# Tutti i ruoli operativi: hub connettori (Gmail, Instagram, Airtable, social)
COMPOSIO_API_KEY=

# SCOUT / builder: automazioni n8n (harvest creator, tracking)
N8N_API_KEY=

# Fallback CRM senza Composio (accesso diretto Airtable)
AIRTABLE_API_KEY=

# Dashboard Mission Control (solo builder/deploy Railway, non i ruoli)
# INGEST_KEY arriva ai ruoli nel messaggio della routine, non da qui.
